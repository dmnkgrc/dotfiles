          "editor"
        ]
      },
      {
        "id": "manager",
        "title": "Annotations",
        "placement": "popup",
        "width": 100,
        "height": 30,
        "command": [
          "./bin/herdr-annotate.exe",
          "manager"
        ]
      }
    ],
    "link_handlers": [
      {
        "id": "markdown-file",
        "title": "Annotate this file",
        "pattern": "^file://.*\\.(md|markdown|mdx)$",
        "action": "open-link",
        "platforms": [
          "macos",
          "linux"
        ]
      }
    ],
    "source": {
