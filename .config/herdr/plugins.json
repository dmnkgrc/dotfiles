[
  {
    "plugin_id": "annotate",
    "name": "Annotate",
    "version": "0.4.0",
    "min_herdr_version": "0.8.0",
    "description": "Comment on terminal selections and copy annotations as agent context.",
    "manifest_path": "/Users/dominikgarciabertapelle/dotfiles/.config/herdr/plugins/github/annotate-9c299759567c/herdr-plugin.toml",
    "plugin_root": "/Users/dominikgarciabertapelle/dotfiles/.config/herdr/plugins/github/annotate-9c299759567c",
    "enabled": true,
    "platforms": [
      "linux",
      "macos",
      "windows"
    ],
    "build": [
      {
        "platforms": [
          "macos",
          "linux"
        ],
        "command": [
          "bash",
          "scripts/fetch-herdr-annotate.sh"
