{
  "name": "dominik-pi-config",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "config:check": "node scripts/validate-config.mjs",
    "format": "prettier --check \"agent/**/*.{ts,json,md}\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"*.{json,md}\"",
    "format:write": "prettier --write \"agent/**/*.{ts,json,md}\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"*.{json,md}\"",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "verify": "npm run config:check && npm run check && npm test && npm run format"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@types/node": "26.2.0",
    "prettier": "3.9.6",
    "typebox": "1.3.7",
    "typescript": "7.0.2"
  }
}
