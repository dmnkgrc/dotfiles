{
  "mcpServers": {
    "linear": {
      "url": "https://mcp.linear.app/mcp",
      "auth": "oauth",
      "lifecycle": "lazy"
    },
    "fallow": {
      "command": "fallow-mcp",
      "lifecycle": "lazy"
    },
    "expect": {
      "command": "npx",
      "args": [
        "-y",
        "expect-cli@0.1.3",
        "mcp"
      ],
      "lifecycle": "lazy"
    },
    "cortea": {
      "url": "https://executor.sh/cortea/mcp"
    },
    "conductor": {
      "url": "https://api.conductor.build/mcp",
      "auth": "oauth",
      "lifecycle": "lazy"
    }
  }
}
